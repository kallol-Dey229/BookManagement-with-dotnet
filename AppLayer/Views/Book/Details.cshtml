@model BLL.DTOs.BookDTO


<div class="container mt-5">

    <div class="card p-4">

        <div class="row">

            <!-- LEFT IMAGE -->

            <div class="col-md-5 text-center">

                <img src="@Model.Image"
                     class="img-fluid rounded"
                     style="height:450px; object-fit:contain;" />

            </div>


            <!-- RIGHT DETAILS -->

            <div class="col-md-7">

                <h1 class="fw-bold mb-3">

                    @Model.Title

                </h1>

                <h3 class="text-success mb-4">

                    @Model.Price Tk

                </h3>

                <h5 class="mb-3">

                    Category Id :
                    @Model.Cid

                </h5>

                <p style="
                    font-size:18px;
                    line-height:32px;
                    color:#4B5563;">

                    @Model.Description

                </p>


                @if (Context.Session.GetString("Role") == "User")
                {
                    <a class="btn btn-success btn-lg mt-3"
                       asp-controller="Cart"
                       asp-action="AddToCart"
                       asp-route-id="@Model.Id">

                        Add To Cart

                    </a>
                }

                <div class="mt-4">

                    <a asp-action="Index"
                       class="btn btn-dark">

                        Back To Books

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
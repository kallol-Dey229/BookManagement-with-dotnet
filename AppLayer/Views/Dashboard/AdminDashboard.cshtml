@model List<BLL.DTOs.UserDTO>

<h2 class="mb-4 fw-bold">
    Admin Dashboard
</h2>

<!-- Statistics -->

<div class="row mb-5">

    <div class="col-md-4">

        <div class="card border-0 shadow-sm text-center p-4">

            <h1>📚</h1>

            <h2>@ViewBag.TotalBooks</h2>

            <p class="text-muted mb-0">
                Total Books
            </p>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card border-0 shadow-sm text-center p-4">

            <h1>📂</h1>

            <h2>@ViewBag.TotalCategories</h2>

            <p class="text-muted mb-0">
                Total Categories
            </p>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card border-0 shadow-sm text-center p-4">

            <h1>👥</h1>

            <h2>@ViewBag.TotalUsers</h2>

            <p class="text-muted mb-0">
                Total Users
            </p>

        </div>

    </div>

</div>


<!-- Users -->

<div class="card border-0 shadow-sm">

    <div class="card-header bg-transparent">

        <h4 class="mb-0">
            Registered Users
        </h4>

    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Name</th>

                    <th>Email</th>

                    <th>Role</th>

                    <th class="text-center">
                        Action
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var u in Model)
                {
                    <tr>

                        <td>
                            @u.Name
                        </td>

                        <td>
                            @u.Email
                        </td>

                        <td>

                            @if (u.Role == "Admin")
                            {
                                <span class="badge bg-danger">
                                    Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    User
                                </span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="DeleteUser"
                               asp-route-id="@u.Id"
                               class="btn btn-sm btn-outline-danger">

                                Delete

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- Navigation Buttons -->

<div class="mt-4 d-flex gap-2">

    <a asp-controller="Book"
       asp-action="Index"
       class="btn btn-primary">

        📚 Manage Books

    </a>

    <a asp-controller="Category"
       asp-action="Index"
       class="btn btn-success">

        📂 Manage Categories

    </a>

</div>
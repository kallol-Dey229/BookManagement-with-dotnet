<div class="d-flex justify-content-center align-items-center">

    <div class="card profile-card p-5">

        <!-- PROFILE ICON -->

        <div class="text-center mb-4">

            <div class="profile-icon">

                👤

            </div>

            <h2 class="mt-3 fw-bold"
                style="color:#1F2937;">

                My Profile

            </h2>

            <p style="color:#6B7280;">

                Welcome back to BookVerse

            </p>

        </div>


        <!-- NAME -->

        <div class="profile-box mb-3">

            <h6 class="text-muted">

                Full Name

            </h6>

            <h5 class="fw-semibold">

                @Context.Session.GetString("Name")

            </h5>

        </div>


        <!-- EMAIL -->

        <div class="profile-box mb-3">

            <h6 class="text-muted">

                Email Address

            </h6>

            <h5 class="fw-semibold">

                @Context.Session.GetString("Email")

            </h5>

        </div>


        <!-- ROLE -->

        <div class="profile-box">

            <h6 class="text-muted">

                Account Role

            </h6>

            <span class="badge bg-success fs-6 px-3 py-2">

                @Context.Session.GetString("Role")

            </span>

        </div>

    </div>

</div>



<style>

    .profile-card {
        width: 700px;
        border: none;
        border-radius: 25px;
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .profile-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #86EFAC, #34D399);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        font-size: 45px;
        box-shadow: 0 6px 20px rgba(0,0,0,.12);
    }

    .profile-box {
        background: rgba(255,255,255,0.7);
        padding: 18px;
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,.5);
    }

</style>
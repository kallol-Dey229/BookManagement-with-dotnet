@using DAL.EF
@using DAL.EF.Tables
@inject BookManagementContext db

@{
    ViewData["Title"] = "My Products";

    var cart = Context.Session.GetString("cart");

    List<int> ids = new List<int>();

    if (cart != null)
    {
        ids = cart.Split(',')
                  .Select(int.Parse)
                  .ToList();
    }

    var grouped = ids.GroupBy(x => x)
                     .Select(x => new
                     {
                         Id = x.Key,
                         Quantity = x.Count()
                     })
                     .ToList();

    decimal total = 0;
}

<div class="row">

    <!-- LEFT SIDE : PRODUCTS -->

    <div class="col-md-8">

        <h2 class="mb-4">
            My Cart
        </h2>

        @foreach (var item in grouped)
        {
            var b = db.Books.FirstOrDefault(x => x.Id == item.Id);

            var subtotal = b.Price * item.Quantity;

            total += subtotal;

            <div class="card mb-3 shadow-sm">

                <div class="row g-0 align-items-center">

                    <!-- IMAGE -->

                    <div class="col-md-3 text-center">

                        <img src="@b.Image"
                             style="height:150px;
                                        width:100%;
                                        object-fit:contain;
                                        padding:10px;" />

                    </div>

                    <!-- DETAILS -->

                    <div class="col-md-6">

                        <div class="card-body">

                            <h5 class="card-title">
                                @b.Title
                            </h5>

                            <p>

                                <strong>
                                    Price:
                                </strong>

                                @b.Price Tk

                            </p>

                            <p>

                                <strong>
                                    Quantity:
                                </strong>

                                @item.Quantity

                            </p>

                            <p>

                                <strong>
                                    Subtotal:
                                </strong>

                                @subtotal Tk

                            </p>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>



    <!-- RIGHT SIDE : PRICE SECTION -->

    <div class="col-md-4">

        <div class="card shadow p-4">

            <h3 class="mb-4">
                Price Details
            </h3>

            <div class="d-flex justify-content-between mb-3">

                <span>
                    Total Products
                </span>

                <strong>
                    @grouped.Sum(x => x.Quantity)
                </strong>

            </div>

            <div class="d-flex justify-content-between mb-3">

                <span>
                    Total Price
                </span>

                <strong>
                    @total Tk
                </strong>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <h5>
                    Final Amount
                </h5>

                <h5>
                    @total Tk
                </h5>

            </div>

            <button class="btn btn-primary w-100 mt-4">

                Checkout

            </button>

        </div>

    </div>

</div>